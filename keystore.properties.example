# Copy this file to keystore.properties (and keep keystore.properties out of version control).
# Generate a permanent release keystore once with:
#   keytool -genkey -v -keystore wonderland-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias wonderland
storeFile=wonderland-release.jks
storePassword=CHANGE_ME
keyAlias=wonderland
keyPassword=CHANGE_ME
